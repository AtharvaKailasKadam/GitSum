# GitSum Server — Environment Variables
# Copy this file to .env and fill in your values

# GitHub Personal Access Token (optional but strongly recommended)
# Raises rate limit from 60/hr (unauthenticated) to 5,000/hr
# Generate at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=your_github_pat_here

# Port the server will listen on
PORT=3001

# Allowed frontend origin (update for production)
CLIENT_ORIGIN=http://localhost:5173
